From: OpenWrt
Date: Sat, 21 Mar 2026 00:00:00 +0000
Subject: [PATCH] wifi: mt76: mt7915: add thermal zone sensor support

Register mt7915 as a thermal zone sensor when #thermal-sensor-cells
is present in the device tree. This allows DTS thermal zones to use
WiFi temperature for fan control (e.g. wifi0-thermal, wifi1-thermal).

Signed-off-by: OpenWrt
---
 mt7915/init.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/mt7915/init.c b/mt7915/init.c
index 04788db..db1391c 100644
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -177,6 +177,25 @@
 	.set_cur_state = mt7915_thermal_set_cur_throttle_state,
 };
 
+static int mt7915_thermal_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct mt7915_phy *phy = thermal_zone_device_priv(tz);
+	int ret;
+
+	mutex_lock(&phy->dev->mt76.mutex);
+	ret = mt7915_mcu_get_temperature(phy);
+	mutex_unlock(&phy->dev->mt76.mutex);
+	if (ret < 0)
+		return ret;
+
+	*temp = ret * 1000; /* millidegree Celsius */
+	return 0;
+}
+
+static const struct thermal_zone_device_ops mt7915_tz_ops = {
+	.get_temp = mt7915_thermal_get_temp,
+};
+
 static void mt7915_unregister_thermal(struct mt7915_phy *phy)
 {
 	struct wiphy *wiphy = phy->mt76->hw->wiphy;
@@ -212,6 +231,14 @@
 	/* initialize critical/maximum high temperature */
 	phy->throttle_temp[MT7915_CRIT_TEMP_IDX] = MT7915_CRIT_TEMP;
 	phy->throttle_temp[MT7915_MAX_TEMP_IDX] = MT7915_MAX_TEMP;
+
+	if (IS_REACHABLE(CONFIG_THERMAL_OF) &&
+	    of_find_property(wiphy->dev.of_node, "#thermal-sensor-cells", NULL)) {
+		/* Ignore errors - thermal zone may not be in DTS */
+		devm_thermal_of_zone_register(&wiphy->dev,
+					     phy->mt76->band_idx, phy,
+					     &mt7915_tz_ops);
+	}
 
 	if (!IS_REACHABLE(CONFIG_HWMON))
 		return 0;
